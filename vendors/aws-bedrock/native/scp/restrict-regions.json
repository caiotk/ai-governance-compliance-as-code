{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AIG08DenyBedrockOutsideApprovedRegions",
      "Effect": "Deny",
      "Action": "bedrock:*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "ap-southeast-2",
            "ap-southeast-4"
          ]
        }
      }
    }
  ]
}
