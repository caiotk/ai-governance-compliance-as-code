{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AIG07AIG13ProtectBedrockInvocationLogging",
      "Effect": "Deny",
      "Action": [
        "bedrock:PutModelInvocationLoggingConfiguration",
        "bedrock:DeleteModelInvocationLoggingConfiguration"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/PLATFORM_ADMIN_ROLE"
        }
      }
    }
  ]
}
