{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AIG06DenyUnapprovedBedrockModels",
      "Effect": "Deny",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "NotResource": [
        "arn:aws:bedrock:*::foundation-model/amazon.titan-embed-text-v2:0",
        "arn:aws:bedrock:*::foundation-model/APPROVED_MODEL_ID",
        "arn:aws:bedrock:*:*:inference-profile/APPROVED_INFERENCE_PROFILE_ID"
      ]
    }
  ]
}
